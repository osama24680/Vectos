# Copy to .env.local and fill in. CRA only exposes variables prefixed with REACT_APP_.
# Note: these values are embedded in the built JS bundle, so only put browser-safe keys here.

# Flask models API (run "AI Models" locally, or the URL where it's deployed)
REACT_APP_ML_API_URL=http://127.0.0.1:5000

# ThingSpeak channel the smart shoe publishes to (read-only key)
REACT_APP_THINGSPEAK_CHANNEL_ID=
REACT_APP_THINGSPEAK_READ_KEY=
REACT_APP_THINGSPEAK_RESULTS=2

# EmailJS (contact + blog comment forms)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
REACT_APP_EMAILJS_TEMPLATE_BLOG=
REACT_APP_EMAILJS_TEMPLATE_CONTACT=
